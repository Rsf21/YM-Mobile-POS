
<%- include('partials/head') %>

<%
const rp = (n) => 'Rp ' + Math.round(Number(n) || 0).toLocaleString('id-ID');

const qty = (n) => Number(Number(n || 0).toFixed(3)).toLocaleString('id-ID', {
  maximumFractionDigits: 3
});

const totalSales = Number(cash || 0) + Number(qris || 0) + Number(debit || 0);
%>

<style>
.recap-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  align-items: start;
}

.recap-stat-column {
  display: grid;
  grid-template-rows: 34px 88px 88px;
  gap: 8px;
  min-width: 0;
}

.recap-stat-column .stat {
  width: 100%;
  min-width: 0;
  min-height: 88px;
  height: 88px;
  box-sizing: border-box;
}

.recap-invoice-slot {
  height: 34px;
  display: flex;
  align-items: center;
}

.recap-invoice-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  min-height: 32px;
  padding: 7px 12px;
  font-size: 12px;
  line-height: 1;
  white-space: nowrap;
  text-decoration: none;
}

@media (max-width: 480px) {
  .recap-stats {
    gap: 8px;
  }

  .recap-stat-column {
    gap: 8px;
  }
}
</style>

<main class="page">
  <section>
    <h2>
      <%= b.name %>
      <span class="pill"><%= isOpen ? 'berjalan' : 'selesai' %></span>
    </h2>
  </section>

  <section class="recap-stats">
    <div class="recap-stat-column">
      <div class="recap-invoice-slot"></div>

      <div class="stat">
        <span>Uang Modal Kembalian</span>
        <strong><%= rp(b.opening_cash) %></strong>
      </div>

      <div class="stat">
        <span>Total penjualan</span>
        <strong><%= rp(totalSales) %></strong>
      </div>
    </div>

    <div class="recap-stat-column">
      <div class="recap-invoice-slot">
        <% if (!isOpen) { %>
          <a
            href="/bazar/<%= b.id %>/invoice.pdf"
            target="_blank"
            rel="noopener"
            class="btn recap-invoice-btn"
          >
            Unduh Invoice PDF
          </a>
        <% } %>
      </div>

      <div class="stat">
        <span>Penjualan tunai</span>
        <strong><%= rp(cash) %></strong>
      </div>

      <div class="stat">
        <span>Uang tunai seharusnya</span>
        <strong><%= rp(expected) %></strong>
      </div>
    </div>
  </section>

  <% if (isOpen) { %>
    <section class="card stack" style="margin-top:12px">
      <strong>Tutup bazar</strong>

      <div class="muted small">
        Hitung uang tunai di tangan, lalu isi nominal di bawah. Setelah ditutup, kasir bazar ini tidak bisa dipakai lagi.
      </div>

      <form method="post" action="/bazar/<%= b.id %>/tutup" class="stack">
        <label>
          Uang tunai di tangan (Rp)
          <input
            name="closing_cash"
            type="number"
            min="0"
            inputmode="numeric"
            required
          >
        </label>

        <button class="btn" type="submit">
          Tutup bazar
        </button>
      </form>
    </section>
  <% } else { %>
    <section class="card row" style="margin-top:12px">
      <span>Uang tunai dihitung <%= rp(b.closing_cash) %></span>

      <strong class="<%= diff === 0 ? 'good' : 'bad' %>">
        <%= diff === 0 ? 'Pas' : (diff > 0 ? 'Lebih ' : 'Kurang ') + rp(Math.abs(diff)) %>
      </strong>
    </section>
  <% } %>

  <section style="margin-top:20px">
    <h3>Rincian barang</h3>

    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr>
            <th>Barang</th>
            <th>Bawa</th>
            <th>Terjual</th>
            <th>Sisa</th>
            <th>Omzet</th>
          </tr>
        </thead>

        <tbody>
          <% items.forEach(i => { %>
            <tr>
              <td><%= i.name %></td>
              <td><%= qty(i.brought) %></td>
              <td><%= qty(i.sold) %></td>
              <td><%= qty(i.brought - i.sold) %></td>
              <td><%= rp(i.price * i.sold) %></td>
            </tr>
          <% }) %>

          <% if (!items.length) { %>
            <tr>
              <td colspan="5" style="text-align:center">
                Belum ada barang bazar.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include('partials/foot') %>
</body>
</html>
