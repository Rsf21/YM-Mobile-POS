<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <meta name="theme-color" content="#f7f7f8">

  <meta name="description" content="YM Mobile POS adalah aplikasi kasir dan manajemen bazar Yomart yang praktis, modern, dan terintegrasi.">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="YM Mobile POS">
  <meta property="og:title" content="YM Mobile POS - Sistem Kasir Yomart">
  <meta property="og:description" content="Aplikasi kasir dan manajemen bazar Yomart yang praktis, modern, dan terintegrasi.">
  <meta property="og:url" content="https://ym-mobile-pos.vercel.app/">

  <meta property="og:image" content="https://ym-mobile-pos.vercel.app/images/TECH/og-preview.jpg">
  <meta property="og:image:secure_url" content="https://ym-mobile-pos.vercel.app/images/TECH/og-preview.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="YM Mobile POS - Sistem Kasir Yomart">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="YM Mobile POS - Sistem Kasir Yomart">
  <meta name="twitter:description" content="Aplikasi kasir dan manajemen bazar Yomart yang praktis, modern, dan terintegrasi.">
  <meta name="twitter:image" content="https://ym-mobile-pos.vercel.app/images/TECH/og-preview.jpg">

  <link rel="manifest" href="/manifest.json">

  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="YM POS">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">

  <title>YM Mobile POS</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <script src="/js/theme-init.js"></script>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<% if (typeof user !== 'undefined' && user) { %>

<header class="topbar">
  <div class="brand-area">
    <img
      src="/images/TECH/yomartpng.png"
      alt="Logo Yomart"
      class="brand-logo"
    >
  </div>

  <button
    class="menu-toggle"
    id="menu-toggle"
    type="button"
    aria-label="Buka menu"
    aria-expanded="false"
    aria-controls="side-menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<div class="menu-backdrop" id="menu-backdrop" hidden></div>

<aside
  class="side-menu"
  id="side-menu"
  aria-hidden="true"
>

  <div class="side-menu-header">
    <div>
      <strong>Yomart</strong>
      <span>Mobile POS</span>
    </div>

    <button
      class="menu-close"
      id="menu-close"
      type="button"
      aria-label="Tutup menu"
    >
      &times;
    </button>
  </div>

  <div class="side-menu-profile">
    <span class="profile-label">TOKO AKTIF</span>

    <strong><%= user.storeName %></strong>

    <% if (typeof bazaar !== 'undefined' && bazaar) { %>
      <span><%= bazaar.name %></span>
    <% } %>
  </div>

  <nav class="side-nav">

    <span class="side-nav-label">MENU UTAMA</span>

    <a
      href="/"
      class="<%= typeof active !== 'undefined' && active === 'pos' ? 'current' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="8" cy="21" r="1"></circle>
        <circle cx="19" cy="21" r="1"></circle>
        <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
      </svg>
      <span>Kasir</span>
    </a>

    <a
      href="/barang"
      class="<%= typeof active !== 'undefined' && active === 'items' ? 'current' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path>
        <path d="M12 22V12"></path>
        <polyline points="3.29 7 12 12 20.71 7"></polyline>
        <path d="m7.5 4.27 9 5.15"></path>
      </svg>
      <span>Barang Bazar</span>
    </a>

    <a
      href="/riwayat"
      class="<%= typeof active !== 'undefined' && active === 'history' ? 'current' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"></path>
        <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path>
        <path d="M12 17.5v-11"></path>
      </svg>
      <span>Riwayat Transaksi</span>
    </a>

    <% if (user.role === 'admin') { %>
      <span class="side-nav-label">ADMINISTRASI</span>

      <a
        href="/admin"
        class="<%= typeof active !== 'undefined' && active === 'admin' ? 'current' : '' %>"
      >
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="3" width="7" height="9" rx="1"></rect>
          <rect x="14" y="3" width="7" height="5" rx="1"></rect>
          <rect x="14" y="12" width="7" height="9" rx="1"></rect>
          <rect x="3" y="16" width="7" height="5" rx="1"></rect>
        </svg>
        <span>Dashboard Admin</span>
      </a>

      <a
        href="/admin/bazar"
        class="<%= typeof active !== 'undefined' && active === 'admin-bazaars' ? 'current' : '' %>"
      >
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
          <path d="M2 7h20"></path>
          <path d="M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7"></path>
        </svg>
        <span>Manajemen Bazar</span>
      </a>
    <% } %>

    <a
      href="/faq"
      class="<%= typeof active !== 'undefined' && active === 'faq' ? 'current' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
        <path d="M12 17h.01"></path>
      </svg>
      <span>Pusat Bantuan / FAQ</span>
    </a>

    <a
      href="/about"
      class="<%= typeof active !== 'undefined' && active === 'about' ? 'current' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 16v-4"></path>
        <path d="M12 8h.01"></path>
      </svg>
      <span>Tentang Aplikasi</span>
    </a>

    <a
      href="/meet-developer"
      class="<%= typeof active !== 'undefined' && active === 'meet-developer' ? 'current' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m18 16 4-4-4-4"></path>
        <path d="m6 8-4 4 4 4"></path>
        <path d="m14.5 4-5 16"></path>
      </svg>
      <span>Meet the Developer</span>
    </a>

  </nav>

  <div class="side-menu-theme">

    <div class="side-menu-theme-info">
      <strong>Tampilan</strong>
      <span>Mode terang atau gelap</span>
    </div>

    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="Ganti tema"
      title="Ganti tema"
    >
      <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l-1.42 1.42m11.3-11.3 1.42-1.42"></path>
      </svg>

      <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>
      </svg>
    </button>

  </div>

  <div class="side-menu-footer">

    <form method="post" action="/logout">
      <button class="logout-button" type="submit">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Keluar dari akun
      </button>
    </form>

  </div>

</aside>

<% } %>

<main class="page">