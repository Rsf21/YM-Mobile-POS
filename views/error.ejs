<%- include('partials/head') %>
<% const errorCode = (typeof status !== 'undefined' && status) ? status : null; %>
<section class="error-page" role="alert">

  <div class="error-scene" aria-hidden="true">
    <svg viewBox="0 0 240 190" xmlns="http://www.w3.org/2000/svg">

      <ellipse class="error-shadow" cx="120" cy="176" rx="56" ry="6"></ellipse>

      <g class="error-paper">
        <rect x="42" y="20" width="132" height="134" rx="14" class="paper-body"></rect>
        <rect x="58" y="40" width="64" height="8" rx="4" class="paper-line strong"></rect>
        <rect x="58" y="60" width="100" height="6" rx="3" class="paper-line"></rect>
        <rect x="58" y="76" width="88" height="6" rx="3" class="paper-line"></rect>
        <rect x="58" y="92" width="100" height="6" rx="3" class="paper-line"></rect>
        <rect x="58" y="108" width="70" height="6" rx="3" class="paper-line"></rect>
        <rect x="58" y="124" width="92" height="6" rx="3" class="paper-line"></rect>
      </g>

      <g class="error-glass">
        <line x1="150" y1="118" x2="190" y2="158" class="glass-handle"></line>
        <line x1="150" y1="118" x2="160" y2="128" class="glass-neck"></line>

        <circle cx="122" cy="90" r="36" class="glass-lens"></circle>
        <circle cx="122" cy="90" r="36" class="glass-ring"></circle>
        <path d="M100 76 A26 26 0 0 1 118 64" class="glass-shine"></path>

        <g class="glass-mark">
          <line x1="122" y1="76" x2="122" y2="94" class="mark-stroke"></line>
          <circle cx="122" cy="105" r="2.6" class="mark-dot"></circle>
        </g>
      </g>

    </svg>
  </div>

  <% if (errorCode) { %>
    <span class="error-code"><%= errorCode %></span>
  <% } else { %>
    <span class="error-code">Ups!</span>
  <% } %>

  <h1 class="error-title"><%= message %></h1>
  <p class="error-hint">Halaman yang kamu cari tidak ditemukan</p>

  <a class="btn" href="/">
    <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m15 18-6-6 6-6"></path>
    </svg>
    Kembali
  </a>

</section>
</body>
</html>