<%- include('partials/head') %>
<%- include('partials/dashboard-info') %>

<%
const rp = (n) => 'Rp ' + Number(n).toLocaleString('id-ID');
%>

<h2>Bazar</h2>

<% if (err) { %>

  <div class="alert"><%= err %></div> <% } %>

<section id="install-app-card" class="card install-app-card" hidden>   <div class="install-app-content">     <div class="install-app-icon">       <img src="/icons/icon-192.png" alt="YM Mobile POS">     </div>

<div class="install-app-info">
  <strong>YM Mobile POS</strong>
  <p class="muted small">
    Pasang aplikasi untuk akses lebih cepat dan praktis.
  </p>
</div>

  </div>

  <button id="btn-install-app" class="btn" type="button">     Unduh Aplikasi   </button> </section>

<section class="card stack">   <strong>Mulai bazar baru</strong>

  <form method="post" action="/bazar" class="stack">     <label>       Nama bazar atau lokasi       <input name="name" maxlength="60" required>     </label>

<label>
  Uang kembalian yang dibawa (Rp)
  <input name="opening_cash" inputmode="numeric" value="0" required>
</label>

<button class="btn" type="submit">Mulai</button>

  </form> </section>

<h3>Riwayat Bazar</h3>

<% if (!rows || rows.length === 0) { %>

  <section class="card stack" style="text-align:center;padding:28px 16px">
    <strong>Belum Ada Riwayat Bazar</strong>

<p class="muted small">
  Riwayat bazar akan muncul di sini setelah kamu memulai bazar baru.
</p>

  </section>

<% } else { %>

  <ul class="list">
    <% rows.forEach(b => { %>
      <li>
        <div class="row">
          <span>
            <div>
              <%= b.name %>
              <span class="pill">
                <%= b.status === 'open' ? 'berjalan' : 'selesai' %>
              </span>
            </div>

        <div class="muted small">
          <%= new Date(b.opened_at).toLocaleString('id-ID', {
            timeZone: 'Asia/Jakarta'
          }) %>
          - kembalian <%= rp(b.opening_cash) %>
        </div>
      </span>
    </div>

    <div class="actions" style="margin-top:10px">
      <% if (b.status === 'open') { %>
        <form method="post" action="/bazar/<%= b.id %>/pilih">
          <button class="btn" type="submit" style="width:100%">
            <%= current === b.id ? 'Buka kasir' : 'Lanjutkan' %>
          </button>
        </form>
      <% } else { %>
        <span></span>
      <% } %>

      <a class="btn ghost" href="/bazar/<%= b.id %>/rekap">
        Rekap
      </a>
    </div>
  </li>
<% }) %>

  </ul>

<% } %>

<script>
  let deferredInstallPrompt = null;

  const installCard = document.getElementById("install-app-card");
  const installButton = document.getElementById("btn-install-app");

  window.addEventListener("beforeinstallprompt", (event) => {
    event.preventDefault();

    deferredInstallPrompt = event;
    installCard.hidden = false;
  });

  installButton.addEventListener("click", async () => {
    if (!deferredInstallPrompt) return;

    deferredInstallPrompt.prompt();

    const result = await deferredInstallPrompt.userChoice;

    if (result.outcome === "accepted") {
      installCard.hidden = true;
    }

    deferredInstallPrompt = null;
  });

  window.addEventListener("appinstalled", () => {
    installCard.hidden = true;
    deferredInstallPrompt = null;
  });
</script>

<script src="/js/dashboard-info.js"></script>

<%- include('partials/foot') %>

</body>
</html>